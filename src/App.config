            <setting name="LensRadius" serializeAs="String">
                <value>150</value>
            </setting>
            <setting name="MotionThreshold" serializeAs="String">
                <value>10</value>
            </setting>
            <setting name="SecondsUntilPanMode" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="MotionThresholdXY" serializeAs="String">
                <value>50</value>
            </setting>
            <setting name="MotionThresholdZ" serializeAs="String">
                <value>10</value>
            </setting>
            <setting name="Acceleration" serializeAs="String">
                <value>100</value>
            </setting>
            <setting name="Address" serializeAs="String">
                <value>ws://localhost</value>
            </setting>
            <setting name="Port" serializeAs="String">
                <value>40001</value>
            </setting>
            <setting name="EndPoint" serializeAs="String">
