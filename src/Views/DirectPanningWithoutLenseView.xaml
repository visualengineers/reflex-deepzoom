 <UserControl x:Class="ReFlex.Apps.DeepZoom.Views.DirectPanningWithoutLenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ReFlex.Apps.DeepZoom.ViewModels"
             xmlns:views="clr-namespace:ReFlex.Apps.DeepZoom.Views"

             mc:Ignorable="d"
             mvvm:ViewModelLocator.AutoWireViewModel="True"

             Height="{Binding UserControlHeight, Mode=TwoWay}" 
             Width="{Binding UserControlWidth, Mode=TwoWay}"
             d:DataContext="{d:DesignInstance viewModels:DirectPanningWithoutLenseViewModel}">

    <Grid
        Background="Black">

        <Image
            Source="{Binding FullImageSource.Image}">

            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform 
                        CenterX="{Binding ZoomCenter.X}"
                        CenterY="{Binding ZoomCenter.Y}"
                        ScaleX="{Binding Scale}"
                        ScaleY="{Binding Scale}"/>
                </TransformGroup>
            </Image.RenderTransform>

        </Image>
        
        <Image
            Source="{Binding ImageSourceOverlay.Image}"
            Opacity="{Binding OverlayOpacity}"
            Visibility="{Binding HasOverlay, Converter={StaticResource BooleanVisibilityConverter}}">
        
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform
                        CenterX="{Binding ZoomCenter.X}"
                        CenterY="{Binding ZoomCenter.Y}"
                        ScaleX="{Binding Scale}"
                        ScaleY="{Binding Scale}"/>
                </TransformGroup>
            </Image.RenderTransform>
        
        </Image>
        
        <views:MiniMap 
            Visibility="{Binding ShowMiniMap, Converter={StaticResource BooleanVisibilityConverter}}"
            Width="{Binding MiniMapSize.Width}"
            Height="{Binding MiniMapSize.Height}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="50"/>

    </Grid>

</UserControl>
