<UserControl x:Class="ReFlex.Apps.DeepZoom.Views.MiniMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:calcBinding="clr-namespace:CalcBinding;assembly=CalcBinding"
             xmlns:viewModels="clr-namespace:ReFlex.Apps.DeepZoom.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance viewModels:IZoomImageViewModel}">
    <Grid>
        <Image Source="{Binding PreviewSource.Image}"/>
        <Border BorderBrush="White" BorderThickness="1"/>
        <Border BorderBrush="Coral" BorderThickness="1" Background="#66ffffff">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform 
                        CenterX="{calcBinding:Binding LastInteraction.Position.X * MiniMapSize.Width }"
                        CenterY="{calcBinding:Binding LastInteraction.Position.Y * MiniMapSize.Height}"
                        ScaleX="{calcBinding:Binding 1.0 / Scale}"
                        ScaleY="{calcBinding:Binding 1.0 / Scale}"/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
